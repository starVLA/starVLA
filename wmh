tail_pattern() {
  local pattern="$1"
  local alias_name="$2"
  local log
  log="$(latest_file "${LOG_DIR}" "${pattern}")"
  if [[ -z "${log}" ]]; then
    echo "no log found for pattern: ${pattern}" >&2
    exit 2
  fi
  link_alias "${log}" "${alias_name}"
  tail -f "${LOCAL_LINK_DIR}/${alias_name}"
}

status_pattern() {
  local pattern="$1"
  local alias_name="$2"
  local log
  log="$(latest_file "${LOG_DIR}" "${pattern}")"
  if [[ -z "${log}" ]]; then
    echo "no log found for pattern: ${pattern}" >&2
    exit 2
  fi
  link_alias "${log}" "${alias_name}"
  echo "log: ./wmh_links/${alias_name}"
  echo "mtime/size:"
  stat -L -c '  %y  %s bytes' "${LOCAL_LINK_DIR}/${alias_name}" || true
  echo "key lines:"
  grep -E 'visible CUDA|command:|loading checkpoint|action_horizon|step_sampling|step-sampling|data-config|Step |Loss|grad_norm|Checkpoint saved|Training complete|Traceback|Error|Exception|Killed|ChildFailed|out of memory|CUDA' "${LOCAL_LINK_DIR}/${alias_name}" \
    | tail -40 \
    | sed 's#/inspire/[^ ]*#<long-path>#g' || true
  echo "tail:"
  tail -12 "${LOCAL_LINK_DIR}/${alias_name}" | sed 's#/inspire/[^ ]*#<long-path>#g'
}

status_mirror_eval() {
  local log eval_dir metrics_count results_count root_metrics
  log="$(latest_file "${LOG_DIR}" 'eval_mirror_*.log')"
  eval_dir="$(latest_dir "${REPORT_DIR}" 'eval_mirror_*')"
  if [[ -z "${log}" && -z "${eval_dir}" ]]; then
    echo "no mirror eval found" >&2
    exit 2
  fi
  link_alias "${log}" latest_mirror_eval.log
  link_alias "${eval_dir}" latest_mirror_eval
  echo "eval: ./wmh_links/latest_mirror_eval"
  if [[ -n "${log}" ]]; then
    echo "log: ./wmh_links/latest_mirror_eval.log"
    echo "launcher key lines:"
    grep -E 'parallel-eval|collected|done|metrics|Traceback|Error|Exception|out of memory|Policy server exited|Timed out' "${LOCAL_LINK_DIR}/latest_mirror_eval.log" \
      | tail -60 \
      | sed 's#/inspire/[^ ]*#<long-path>#g' || true
  fi
  if [[ -n "${eval_dir}" && -d "${eval_dir}" ]]; then
    metrics_count="$(find "${eval_dir}" -mindepth 2 -maxdepth 2 -name metrics.json 2>/dev/null | wc -l)"
    results_count="$(find "${eval_dir}" -mindepth 2 -maxdepth 2 -name results.json 2>/dev/null | wc -l)"
    root_metrics="no"
    [[ -f "${eval_dir}/metrics.json" ]] && root_metrics="yes"
    echo "worker metrics: ${metrics_count}"
    echo "worker results: ${results_count}"
    echo "root metrics: ${root_metrics}"
  fi
}

status_candidates_eval() {
  local log eval_dir
  log="$(latest_file "${LOG_DIR}" 'eval_compare_d_n*.log')"
  eval_dir="$(latest_dir "${REPORT_DIR}" 'eval_compare_d_n*')"
