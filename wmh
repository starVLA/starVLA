latest_file() {
  local dir="$1"
  local pattern="$2"
  find "${dir}" -maxdepth 1 -type f -name "${pattern}" -printf '%T@ %p\n' 2>/dev/null \
    | sort -nr \
    | head -1 \
    | cut -d' ' -f2-
}

latest_dir() {
  local dir="$1"
  local pattern="$2"
  find "${dir}" -maxdepth 1 -type d -name "${pattern}" -printf '%T@ %p\n' 2>/dev/null \
    | sort -nr \
    | head -1 \
    | cut -d' ' -f2-
}

latest_checkpoint() {
  local run_pattern="$1"
  local run
  run="$(latest_dir "${RUN_DIR}" "${run_pattern}")"
  if [[ -z "${run}" ]]; then
    return 0
  fi
  find "${run}/checkpoints" -maxdepth 1 -type f -name 'steps_*_pytorch_model.pt' -printf '%T@ %p\n' 2>/dev/null \
    | sort -nr \
    | head -1 \
    | cut -d' ' -f2-
}

link_alias() {
  local target="$1"
  local alias_name="$2"
  [[ -n "${target}" ]] || return 0
  ln -sfn "${target}" "${LOCAL_LINK_DIR}/${alias_name}"
}

detect_visible_gpu_ids() {
  if [[ -n "${CUDA_VISIBLE_DEVICES:-}" && "${CUDA_VISIBLE_DEVICES}" != "NoDevFiles" ]]; then
    echo "${CUDA_VISIBLE_DEVICES}"
    return 0
  fi
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=index --format=csv,noheader 2>/dev/null \
      | awk 'NF {gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}' \
      | paste -sd, -
  fi
}

count_csv_items() {
  local csv="$1"
  if [[ -z "${csv}" ]]; then
    echo 0
    return 0
  fi
  awk -F',' '{count=0; for (i=1; i<=NF; i++) if ($i != "") count++; print count}' <<<"${csv}"
}

configure_gpu_defaults() {
  local fallback_ids="$1"
  local detected_ids count
  if [[ -z "${GPU_IDS+x}" ]]; then
    detected_ids="$(detect_visible_gpu_ids)"
    export GPU_IDS="${detected_ids:-${fallback_ids}}"
  fi
  if [[ -z "${NUM_PROCESSES+x}" ]]; then
    count="$(count_csv_items "${GPU_IDS}")"
    if (( count <= 0 )); then
      count="$(count_csv_items "${fallback_ids}")"
    fi
    export NUM_PROCESSES="${count}"
  fi
}

