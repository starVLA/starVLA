launch_moe_lora() {
  local variant="$1"
  local default_prefix log_alias run_alias
  case "${variant}" in
    aug)
      default_prefix="abc_moe95k_lora_aug"
      log_alias="latest_moe_lora_aug.log"
      run_alias="latest_moe_lora_aug_run"
      ;;
    mirror)
      default_prefix="abc_moe95k_lora_mirror"
      log_alias="latest_moe_lora_mirror.log"
      run_alias="latest_moe_lora_mirror_run"
      ;;
    *)
      echo "unknown MoE LoRA variant: ${variant}" >&2
      exit 2
      ;;
  esac

  export VARIANT="${variant}"
  export MAX_TRAIN_STEPS="${MAX_TRAIN_STEPS:-2500}"
  export SAVE_INTERVAL="${SAVE_INTERVAL:-250}"
  configure_gpu_defaults "0,1,2,3,4,5,6,7"
  export BATCH_SIZE="${BATCH_SIZE:-16}"
  export DATALOADER_NUM_WORKERS="${DATALOADER_NUM_WORKERS:-8}"
  export DATALOADER_PREFETCH_FACTOR="${DATALOADER_PREFETCH_FACTOR:-2}"
  export RUN_ID="${RUN_ID:-${default_prefix}_${MAX_TRAIN_STEPS}_$(date +%m%d_%H%M%S)}"
  export LOG_PATH="${LOG_PATH:-${LOG_DIR}/${RUN_ID}.log}"
  mkdir -p "${LOG_DIR}"

  nohup setsid bash examples/calvin_autoresearch/scripts/run_train_moe95k_lora_h200.sh \
    </dev/null > "${LOG_PATH}" 2>&1 &

  link_alias "${LOG_PATH}" "${log_alias}"
  link_alias "${RUN_DIR}/${RUN_ID}" "${run_alias}"
  echo "launched MoE95k LoRA ${variant}: ${RUN_ID}"
  echo "tail: ./wmh tail-moe-lora-${variant}"
}

