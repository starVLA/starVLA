  if [[ -z "${ckpt}" ]]; then
    echo "no mirror checkpoint found yet; wait for ./wmh mirror-probe8 to finish" >&2
    exit 2
  fi

  run_name="$(basename "$(dirname "$(dirname "${ckpt}")")")"
  ts="$(date +%m%d_%H%M%S)"
  eval_id="eval_mirror_${run_name}_d_n${total}_${ts}"
  eval_dir="${REPORT_DIR}/${eval_id}"
  log_path="${LOG_DIR}/${eval_id}.log"

  export CKPT="${ckpt}"
  export TOTAL_SEQUENCES="${total}"
  export CALVIN_SEND_STATE=1
  export GPU_IDS=0,1,2,3,4,5,6,7
  export WORKERS_PER_GPU="${WORKERS_PER_GPU:-1}"
  export BASE_PORT="${BASE_PORT:-$((7200 + RANDOM % 400))}"
  export SERVER_READY_TIMEOUT="${SERVER_READY_TIMEOUT:-1200}"
  export RESULT_WAIT_TIMEOUT="${RESULT_WAIT_TIMEOUT:-7200}"
  export DEBUG="${DEBUG:-0}"
  export EVAL_LOG_DIR="${eval_dir}"

  nohup bash examples/calvin_autoresearch/scripts/run_eval_abc_to_d_parallel_auto.sh > "${log_path}" 2>&1 &
  link_alias "${eval_dir}" latest_mirror_eval
  link_alias "${log_path}" latest_mirror_eval.log
