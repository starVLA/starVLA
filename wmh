kill_candidates_eval() {
  echo "stopping candidate eval processes on this machine..."
  pkill -TERM -f 'run_eval_wmh_candidates_n300.sh' 2>/dev/null || true
  pkill -TERM -f 'run_eval_abc_to_d_parallel_auto.sh' 2>/dev/null || true
  pkill -TERM -f 'eval_compare_d_n[0-9]+' 2>/dev/null || true
  pkill -TERM -f 'deployment/model_server/server_policy.py.*--port 7[0-9][0-9][0-9]' 2>/dev/null || true
  sleep 5
  if pgrep -f 'run_eval_wmh_candidates_n300.sh|run_eval_abc_to_d_parallel_auto.sh|eval_compare_d_n[0-9]+|deployment/model_server/server_policy.py.*--port 7[0-9][0-9][0-9]' >/dev/null 2>&1; then
    echo "some candidate eval processes remain; sending SIGKILL..."
    pkill -KILL -f 'run_eval_wmh_candidates_n300.sh' 2>/dev/null || true
    pkill -KILL -f 'run_eval_abc_to_d_parallel_auto.sh' 2>/dev/null || true
    pkill -KILL -f 'eval_compare_d_n[0-9]+' 2>/dev/null || true
    pkill -KILL -f 'deployment/model_server/server_policy.py.*--port 7[0-9][0-9][0-9]' 2>/dev/null || true
  fi
  echo "done. check with: nvidia-smi"
}

